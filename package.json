{
  "name": "mahjong-soul-twitch",
  "version": "2.1.0",
  "description": "Twitch + Discord integration for Mahjong Soul (Steam client): reads the game from the screen and drives chat, an OBS overlay, predictions and Discord Rich Presence.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "build:host": "dotnet build host/MahjongSoulHost.csproj -c Release -nologo -v q",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/screen.test.mjs",
    "package": "node scripts/package.mjs",
    "calibration:publish": "node scripts/publish-calibration.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@twurple/api": "^8.2.0",
    "@twurple/auth": "^8.2.0",
    "@twurple/chat": "^8.2.0",
    "@twurple/eventsub-ws": "^8.2.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "exeName": "MahjongSoul-Twitch",
  "repository": {
    "type": "git",
    "url": "https://github.com/BrooklynVRC/Mahjong-Soul-Twitch-Integration"
  },
  "app": {
    "title": "Mahjong Soul × Twitch",
    "dataFolder": "MahjongSoulTwitch",
    "accent": "#9b6bff",
    "letter": "T"
  }
}
